# ==============================================================================
# XAUUSD (GOLD) TELEGRAM AI SIGNAL BOT — DEMO / PAPER TRADING SOZLAMALARI
# ==============================================================================
# DIQQAT: Ushbu fayldan nusxa olib ".env" deb nomlang va maxfiy kalitlarni kiriting:
#   cp .env.example .env   (yoki Windows'da: copy .env.example .env)
# Hech qachon haqiqiy .env faylini GitHub yoki ommaviy joyga yuklamang!
# ==============================================================================

# 1. TELEGRAM BOT SOZLAMALARI (@BotFather orqali olinadi)
TELEGRAM_BOT_TOKEN=YOUR_BOTFATHER_TOKEN_HERE
# Standart xabar yuboriladigan chat yoki kanal ID (ixtiyoriy; /start bosgan foydalanuvchilar avtomatik ulanadi)
TELEGRAM_DEFAULT_CHAT_ID=

# 2. BOZOR VA ALGORITM SOZLAMALARI
SYMBOL=XAUUSD
TIMEFRAME=15m
# Ma'lumot manbasi: "auto" (Yahoo GC=F + Swissquote XAU/USD + TwelveData + Binance PAXG zaxira),
# "yahoo", "twelvedata", "binance_paxg", yoki "csv"
MARKET_DATA_SOURCE=auto
# TwelveData bepul API kaliti (ixtiyoriy, auto rejimda Yahoo GC=F va Swissquote kalitsiz ishlaydi)
TWELVEDATA_API_KEY=

# Indikator parametrlari
EMA_FAST_PERIOD=50
EMA_SLOW_PERIOD=200
RSI_PERIOD=14
ATR_PERIOD=14

# SL va TP koeffitsiyentlari (ATR 14 ga nisbatan)
ATR_SL_MULTIPLIER=1.5
TP1_RR_RATIO=1.0
TP2_RR_RATIO=2.0
TP3_RR_RATIO=3.0

# Bir xil yo'nalishda ketma-ket signal yubormaslik uchun shamlar oraliq filtri
SIGNAL_COOLDOWN_CANDLES=3

# 3. VIRTUAL PAPER TRADING SOZLAMALARI (HAQIQIY PUL ISHLATILMAYDI)
INITIAL_VIRTUAL_BALANCE=10000.0
RISK_PER_TRADE_PCT=1.0
# TP1 urilganda qolgan pozitsiya SL darajasini Entry (Break-Even) ga ko'chirish (true/false)
MOVE_SL_TO_BE_ON_TP1=false

# 4. POLLING VA WEBHOOK SERVER SOZLAMALARI
POLL_INTERVAL_SECONDS=60
WEBHOOK_ENABLED=true
WEBHOOK_HOST=0.0.0.0
PORT=8000
# Webhook xavfsizlik tokeni (TradingView pullik tarif yoki Email-to-Webhook ko'prigi uchun)
WEBHOOK_SECRET_TOKEN=CHANGE_ME_TO_A_STRONG_RANDOM_SECRET_32_CHARS
WEBHOOK_MAX_AGE_SECONDS=300

# 5. MA'LUMOTLAR BAZASI VA LOGLASH
DATABASE_PATH=data/xauusd_signals.db
LOG_LEVEL=INFO
